# Copia este archivo como .env (NO se sube a GitHub) y coloca tus valores reales.
# En Netlify estas mismas variables se configuran en: Site configuration > Environment variables

SHEETS_API_URL=https://script.google.com/macros/s/TU_ID/exec
SHEETS_TOKEN=tu_token_secreto

AI_PROVIDER=gemini
GEMINI_API_KEY=tu_clave_privada
GEMINI_MODEL=gemini-2.5-flash

# Opcional, si usas OpenAI en lugar de Gemini:
# AI_PROVIDER=openai
# OPENAI_API_KEY=tu_clave_privada
# OPENAI_MODEL=gpt-4.1-mini
